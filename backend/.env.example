# This is an example file. Copy it to a new file named .env and fill in the values.
# Do NOT commit the .env file to version control.

# --- Flask Configuration ---
# A strong, random secret key is required for Flask sessions to work securely.
# You can generate one in your terminal using: python -c 'import secrets; print(secrets.token_hex(16))'
FLASK_SECRET_KEY="YOUR_SUPER_SECRET_FLASK_KEY_HERE"

# --- Google Gemini API Key ---
# Get this from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY_HERE"

# --- Yahoo OAuth Credentials ---
# Get these from Yahoo Developer Console: https://developer.yahoo.com/apps/
# Required for Yahoo Fantasy Sports API integration
YAHOO_CLIENT_ID="YOUR_YAHOO_CLIENT_ID_HERE"
YAHOO_CLIENT_SECRET="YOUR_YAHOO_CLIENT_SECRET_HERE"
